{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": [
      "**/*",
      "!**/node_modules",
      "!**/test-results",
      "!**/playwright-report",
      "!**/artifacts"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "assist": {
    "actions": { "source": { "organizeImports": { "level": "on" } } }
  }
}
