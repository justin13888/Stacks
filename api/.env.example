# Stacks API configuration.
#
# Copy to api/.env and fill in WW_TMDB_API_KEY — with the bundled dev Dex, that
# is the only value you must supply. `just setup` does the copy for you.
#
# Every value can also live in a config.toml (see WW_CONFIG_FILE); environment
# variables take precedence. The authoritative list is core/src/config/env.rs.

# --- Required ---

# PostgreSQL DSN. For `just dev-api` against `just dev-up`:
WW_DATABASE_URL=postgres://stacks:stacks@localhost:5432/stacks

# TMDB v4 read-access token (the long Bearer-style string), or a v3 API key.
# https://www.themoviedb.org/settings/api
WW_TMDB_API_KEY=

# --- OIDC (required; defaults below match the bundled dev Dex) ---

# The issuer URL as the *browser* sees it.
WW_OIDC_ISSUER=http://localhost:5556/dex
WW_OIDC_CLIENT_ID=stacks
WW_OIDC_CLIENT_SECRET=stacks-dev-client-secret
# The SPA's callback route — it forwards the code to the API.
WW_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# Only needed when the API reaches the IdP at a different address than the
# browser does. `just up` sets this to http://dex:5556/dex via compose; leave it
# empty when running the API outside containers.
WW_OIDC_INTERNAL_ISSUER=

# --- Optional ---

# Comma-separated emails provisioned (or promoted on next login) to `admin`.
# Required to reach /api/v1/admin/*, including streaming-server registration.
WW_ADMIN_EMAILS=dev@stacks.local

# Listen address.
WW_BIND=0.0.0.0:8095

# tracing_subscriber EnvFilter directive: trace|debug|info|warn|error, or
# per-module such as `info,stacks_core=debug`.
WW_LOG_LEVEL=info

# Base data directory. Defaults to /data, which suits the container image but
# not a bare `cargo run` — set a writable path for local development.
WW_DATA_DIR=./data

# Comma-separated CORS allowlist. Empty falls back to localhost dev origins; a
# single `*` opens CORS to any origin and logs a warning. Not needed when the
# SPA is served same-origin behind the bundled nginx.
WW_CORS_ALLOWED_ORIGINS=

# Token lifetimes in seconds.
WW_ACCESS_TOKEN_TTL_SECS=900
WW_REFRESH_TOKEN_TTL_SECS=2592000

# How often to enqueue a beam_sync job per enabled streaming server.
WW_BEAM_SYNC_INTERVAL_SECS=3600

# Optional TOML config layered *under* these environment variables.
WW_CONFIG_FILE=config.toml
