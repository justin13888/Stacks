# Stacks — repository-root .env.example.
# Copy to `.env` and fill in. The same file is consumed by docker compose
# and `cargo run` thanks to dotenvy.

# ── Required ─────────────────────────────────────────────────────────────

# PostgreSQL DSN. Match the credentials in compose.dependencies.yaml when
# running locally.
WW_DATABASE_URL=postgresql://stacks:stacks@localhost:5432/stacks

# 32+ byte random secret. Generate with: openssl rand -hex 32
WW_SECRET_KEY=changeme

# TheMovieDB API token (Bearer-style v4 auth token, NOT v3 key).
# Get one at https://www.themoviedb.org/settings/api
WW_TMDB_API_KEY=your_tmdb_api_key_here

# OIDC provider — Zitadel example shape.
# Configure a "Web" / "Code+PKCE" application in your tenant; the redirect
# URI must exactly match WW_OIDC_REDIRECT_URI below.
WW_OIDC_ISSUER=https://your-zitadel-host.example.com
WW_OIDC_CLIENT_ID=your_client_id
WW_OIDC_CLIENT_SECRET=your_client_secret
WW_OIDC_REDIRECT_URI=http://localhost:8095/api/v1/auth/callback

# ── Optional ─────────────────────────────────────────────────────────────

WW_BIND=0.0.0.0:8095
WW_LOG_LEVEL=info
WW_DATA_DIR=/data
WW_CAMEO_CACHE_DIR=/data/cameo
WW_ACCESS_TOKEN_TTL_SECS=900
WW_REFRESH_TOKEN_TTL_SECS=2592000
WW_BEAM_SYNC_INTERVAL_SECS=3600

# CLI helper — only read by stacks-cli, ignored by the API.
STACKS_API=http://localhost:8095
# STACKS_TOKEN=<paste after web login>
