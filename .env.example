# Environment for `docker compose` / `podman compose` (i.e. `just up`).
#
# `just up` passes api/.env to compose via --env-file, so for the normal flow you
# only need api/.env and can ignore this file. It exists for deployments that
# invoke compose directly.
#
# The defaults below match the bundled development Dex (compose.dex.yaml).

# TMDB v4 read-access token — the only value you must supply.
WW_TMDB_API_KEY=

# OIDC. These defaults target the bundled dev Dex; point them at a real provider
# for production and drop the `dev-idp` compose profile.
WW_OIDC_ISSUER=http://localhost:5556/dex
WW_OIDC_CLIENT_ID=stacks
WW_OIDC_CLIENT_SECRET=stacks-dev-client-secret
WW_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
# The browser reaches Dex on localhost; the API reaches it on the compose
# network. Leave empty when both use the same URL (the usual production case).
WW_OIDC_INTERNAL_ISSUER=http://dex:5556/dex

# Comma-separated emails granted the admin role on login.
WW_ADMIN_EMAILS=dev@stacks.local

WW_LOG_LEVEL=info
