{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": [
      "**/*",
      "!**/src/api",
      "!**/src/routeTree.gen.ts",
      "!**/openapi.json",
      "!**/tsconfig.tsbuildinfo",
      "!**/node_modules",
      "!**/dist"
    ]
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "fetch": "Only the orval mutator (src/lib/api-client.ts) calls fetch; use the generated hooks in src/api/ (ADR-0007)."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/lib/api-client.ts", "public/sw.js"],
      "linter": { "rules": { "style": { "noRestrictedGlobals": "off" } } }
    }
  ],
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "assist": {
    "actions": { "source": { "organizeImports": { "level": "on" } } }
  }
}
